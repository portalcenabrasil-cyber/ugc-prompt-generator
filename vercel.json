{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "PROMPT.md",
          "PROMPT-serie.md",
          "PROMPT-nano.md",
          "PROMPT-nano-veo-2.md",
          "PROMPT-roupa-feminina.md",
          "PROMPT-roupa-feminina-v2.md",
          "CONTEXT.md",
          "personagens/**",
          "cenarios/**",
          "personagens-masc/**",
          "personagens-donas-casa/**",
          "frases-nichos/**",
          "PROMPT-base-v2.md"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
