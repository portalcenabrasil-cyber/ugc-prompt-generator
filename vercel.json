{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "PROMPT.md",
          "PROMPT-serie.md",
          "PROMPT-nano.md",
          "PROMPT-nano-veo-2.md",
          "CONTEXT.md"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
