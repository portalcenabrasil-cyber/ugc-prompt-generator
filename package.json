{
  "name": "ugc-prompt-generator",
  "version": "1.0.0",
  "description": "Gerador de prompts UGC para TikTok e Instagram Reels",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch lib --watch PROMPT*.md --ext js,md server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pg": "^8.20.0"
  }
}
